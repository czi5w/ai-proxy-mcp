[Unit]
Description=AI_Proxy MCP Bridge (WS server + MCP HTTP server for Hermes Agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit User/Group/paths for your install. Defaults assume:
#   user      = middleware-team
#   checkout  = /home/middleware-team/ai-proxy-mcp
#   venv      = /home/middleware-team/ai-proxy-mcp/.venv
User=middleware-team
Group=middleware-team
WorkingDirectory=/home/middleware-team/ai-proxy-mcp
EnvironmentFile=/home/middleware-team/ai-proxy-mcp/.env
ExecStart=/home/middleware-team/ai-proxy-mcp/.venv/bin/ai-proxy-mcp
Restart=on-failure
RestartSec=5

# Hardening — disable if you hit permission issues during bring-up.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/middleware-team/ai-proxy-mcp
ProtectHome=read-only

[Install]
WantedBy=multi-user.target

# Snippet to merge into ~/.hermes/config.yaml on the host that runs Hermes.
#
# Adds the AI_Proxy MCP bridge as an HTTP-transport MCP server.
# Hermes will discover three tools at startup:
#   mcp_ai_proxy_list_devices
#   mcp_ai_proxy_run_on_device
#   mcp_ai_proxy_get_device_status

mcp_servers:
  ai_proxy:
    url: "http://127.0.0.1:8766/mcp"
    # Generous timeout: a Copilot run can be slow.
    timeout: 600
    # Optional: keep only the tools you want exposed.
    # tools:
    #   include: [list_devices, run_on_device, get_device_status]

# ── WS Server (AI_Proxy reverse-connect) ───────────────────────
# Address that AI_Proxy instances connect back to.
WS_HOST=0.0.0.0
WS_PORT=8765

# ── MCP HTTP Server (Hermes Agent connects here) ───────────────
# Bind to localhost only: Hermes runs on the same machine.
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_PATH=/mcp

# ── Behavior ──────────────────────────────────────────────────
# How long after completion a task remains queryable via get_task_status /
# wait_for_progress (so the LLM can fetch its final state). Older finished
# tasks are pruned every minute.
TASK_RETENTION_SECONDS=600

# Per-call cap on wait_for_progress's timeout argument. Hermes can request
# less; the bridge never waits longer than this. Capping protects HTTP-level
# proxies / the MCP HTTP timeout from being violated.
WAIT_MAX_TIMEOUT=120

# Grace period for an incoming connection to send its register frame.
REGISTER_TIMEOUT_SECONDS=10

# WS keepalive.
# - WS_PING_INTERVAL_SECONDS: send a ping this often to keep NAT/firewall
#   idle timeouts from killing the connection (default 60s — well under
#   the typical 120s NAT timeout).
# - WS_PING_TIMEOUT_SECONDS: deprecated; the server now always disables the
#   pong watchdog for AI_Proxy reverse connections. Keep this at 0 for clarity.
WS_PING_INTERVAL_SECONDS=60
WS_PING_TIMEOUT_SECONDS=0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

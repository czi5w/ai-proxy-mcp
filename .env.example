# ── WS Server (AI_Proxy reverse-connect) ───────────────────────
# Address that AI_Proxy instances connect back to.
WS_HOST=0.0.0.0
WS_PORT=8765

# ── MCP HTTP Server (Hermes Agent connects here) ───────────────
# Bind to localhost only: Hermes runs on the same machine.
MCP_HOST=127.0.0.1
MCP_PORT=8766
MCP_PATH=/mcp

# ── Behavior ──────────────────────────────────────────────────
# Per-task timeout in seconds. A long Copilot run is fine; > 10 min is suspect.
TASK_TIMEOUT_SECONDS=600

# Grace period for an incoming connection to send its register frame.
REGISTER_TIMEOUT_SECONDS=10

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
